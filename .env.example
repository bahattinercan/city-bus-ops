# Copy to .env and fill in real values. Never commit .env or .secrets/.

# --- application -----------------------------------------------------------
DATABASE_URL="postgres://citybus:change-me@127.0.0.1:5435/citybus"

# HMAC key for session cookies. Generate with: openssl rand -hex 32
# Required in production; the app refuses nothing but falls back to a dev-only value.
SESSION_SECRET=""

# Organisation slug resolved on startup; the first request seeds it.
CITYBUS_TENANT_SLUG="kutahya"

# Password for the four demo accounts (admin/planner/dispatcher/driver).
# Required by docker compose; change it for any real deployment.
CITYBUS_DEMO_PASSWORD="demo1234"

# --- docker compose (server only) -----------------------------------------
POSTGRES_DB="citybus"
POSTGRES_USER="citybus"
POSTGRES_PASSWORD=""
CITYBUS_PORT="3000"

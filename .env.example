# Copy to .env and fill in real values. Never commit .env or .secrets/.

# --- application -----------------------------------------------------------
# SQLite is the single dialect (desktop target, docs/09-desktop-app.md). The desktop shell
# passes CITYBUS_DB_FILE itself; for `pnpm dev` this path is the default.
CITYBUS_DB_FILE="./data/citybus.db"
# Optional: where the migrations live when the app runs from a bundle (the shell sets it).
CITYBUS_MIGRATIONS_DIR=

# HMAC key for session cookies. Generate with: openssl rand -hex 32
# Required in production; the app refuses nothing but falls back to a dev-only value.
SESSION_SECRET=""

# Organisation slug resolved on startup; the first request seeds it.
CITYBUS_TENANT_SLUG="kutahya"

# Password for the four demo accounts (admin/planner/dispatcher/driver).
# Required by docker compose; change it for any real deployment.
CITYBUS_DEMO_PASSWORD="demo1234"

# --- planning assistant (optional, free tier works) -----------------------
# Turns one Turkish sentence into a bounded list of plan-cell edits. Off by default:
# with ASSISTANT_ENABLED unset the panel only accepts the deterministic "plate day code"
# lines, and no request ever leaves the server. The model never publishes a plan and never
# writes directly: every proposal is validated and confirmed by a planner first.
#
# Any OpenAI-compatible endpoint works; three free ones (no credit card), pick one:
#
#   Groq (default)   https://api.groq.com/openai/v1          openai/gpt-oss-120b
#                    30 req/min, 1.000 req/day, does not train on your prompts.
#                    key: console.groq.com -> API Keys
#   Gemini (Google)  https://generativelanguage.googleapis.com/v1beta/openai/
#                    gemini-3.5-flash-lite · 1M context, but the free tier may train on
#                    prompts outside EU/UK/EEA — prefer Groq for operator data (KVKK).
#                    key: aistudio.google.com/apikey
#   OpenRouter       https://openrouter.ai/api/v1            openrouter/free
#                    20 req/min, 50 req/day (1.000 after a $10 top-up).
#                    key: openrouter.ai/keys
#
# Gateways that route on a session header can add one as JSON, e.g.
#   ASSISTANT_HEADERS={"x-opencode-session":"<uuid>"}
ASSISTANT_ENABLED="false"
ASSISTANT_BASE_URL="https://api.groq.com/openai/v1"
ASSISTANT_API_KEY=""
ASSISTANT_MODEL="openai/gpt-oss-120b"

# --- docker compose (server only) -----------------------------------------
POSTGRES_DB="citybus"
POSTGRES_USER="citybus"
POSTGRES_PASSWORD=""
CITYBUS_PORT="3000"

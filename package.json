{
  "name": "city-bus-ops",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "build": "pnpm --filter @citybus/web build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @citybus/db generate",
    "db:migrate": "pnpm --filter @citybus/db migrate",
    "desktop:server": "pnpm --filter @citybus/web build",
    "desktop:package": "pnpm --filter @citybus/web build && pnpm --filter @citybus/desktop package",
    "desktop:self-test": "pnpm --filter @citybus/desktop self-test",
    "desktop:start": "pnpm --filter @citybus/desktop start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
